{
  // Schema ships with the installed biome version, so it never needs a manual bump
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // "!!" = force-ignore: never even index these (build outputs, static assets)
    "includes": [
      "**",
      "!!dist",
      "!!storybook-static",
      "!!public",
      "!mock-api/**/*.json",
      "!src/fixtures"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    // Domains are auto-detected from package.json, listed here to make it explicit
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 18 }
        },
        "noForEach": "error"
      },
      "correctness": {
        "noUnusedImports": { "level": "error", "fix": "safe" },
        "noUnusedVariables": {
          "level": "error",
          "options": { "ignoreRestSiblings": true }
        },
        // Carried over from the previous eslint config
        "noSwitchDeclarations": "off",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "style": {
        // Was allowed by the previous eslint config
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // Index keys are fine for the static, non-reorderable lists this app renders
        "noArrayIndexKey": "off",
        "noDoubleEquals": "error",
        "noDebugger": "warn",
        // @ts-ignore with description was allowed by the previous eslint config
        "noTsIgnore": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      // mock data generators are branchy on purpose
      "includes": ["mock-api/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      // tailwind v3 entry directives
      "includes": ["src/index.css"],
      "linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } }
    }
  ]
}
