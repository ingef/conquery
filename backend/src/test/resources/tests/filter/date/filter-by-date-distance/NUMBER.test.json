{
  "type": "FILTER_TEST",
  "label": "Filter by date distance",
  "expectedCsv": "tests/filter/date/filter-by-date-distance/expected_NUMBER_Filter.csv",
  "dateRange" : {
    "min" : "2000-01-31",
    "max" : "2000-02-20"
  },
  "content": {
    "tables": {
      "csv": "tests/filter/date/filter-by-date-distance/content_NUMBER_Filter.csv",
      "primaryColumn": {
        "name": "pid",
        "type": "STRING"
      },
      "columns": [
        {
          "name": "datum",
          "type": "DATE"
        },{
          "name": "validity",
          "type": "DATE"
        }
      ]
    }
  },
  "connector": {
    "validityDates": {
      "label": "Datum",
      "column": "table.validity"
    },
    "filters": {
      "timeUnit" : "DAYS",
      "column": "table.datum",
      "type": "DATE_DISTANCE"
    }
  },
  "filterValue": {
    "type": "INTEGER_RANGE",
    "value": {
      "min": 10,
      "max": 10
    }
  }
}
